# Server-only. Never prefix this variable with VITE_.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_EVIDENCE_ITEMS=40
GROQ_MAX_BATCHES=14
GROQ_DAILY_ANALYSIS_LIMIT=20
TRIPADVISOR_API_KEY=your-tripadvisor-terra-api-key
SERPAPI_API_KEY=your-serpapi-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
TAVILY_API_KEY=your-tavily-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_DAILY_REQUEST_LIMIT=50

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_APP_URL=http://127.0.0.1:8444
